@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Windows has no fnmatch(3). Translate the flags-free subset used by libalpm
+ * to the POSIX regular expressions supplied by libgnurx. */
+#include <regex.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "fnmatch-windows.h"
+
+static const char *bracket_end(const char *cursor)
+{
+	if(*cursor == '!' || *cursor == '^') {
+		cursor++;
+	}
+	if(*cursor == ']') {
+		cursor++;
+	}
+
+	while(*cursor != '\0') {
+		if(*cursor == '\\' && cursor[1] != '\0') {
+			cursor += 2;
+			continue;
+		}
+		if(*cursor == '[' &&
+				(cursor[1] == ':' || cursor[1] == '.' || cursor[1] == '=')) {
+			char marker = cursor[1];
+			const char *inner = cursor + 2;
+			while(*inner != '\0' && !(inner[0] == marker && inner[1] == ']')) {
+				inner++;
+			}
+			if(*inner != '\0') {
+				cursor = inner + 2;
+				continue;
+			}
+		}
+		if(*cursor == ']') {
+			return cursor;
+		}
+		cursor++;
+	}
+
+	return NULL;
+}
+
+int alpm_fnmatch_windows(const char *pattern, const char *string, int flags)
+{
+	static const char regex_special[] = ".^$+(){}|\\";
+	size_t pattern_len;
+	char *expression;
+	char *output;
+	regex_t regex;
+	int result;
+
+	if(pattern == NULL || string == NULL || flags != 0) {
+		return FNM_NOMATCH;
+	}
+
+	pattern_len = strlen(pattern);
+	expression = malloc(pattern_len * 4 + 3);
+	if(expression == NULL) {
+		return FNM_NOMATCH;
+	}
+
+	output = expression;
+	*output++ = '^';
+	while(*pattern != '\0') {
+		if(*pattern == '*') {
+			*output++ = '.';
+			*output++ = '*';
+			pattern++;
+		} else if(*pattern == '?') {
+			*output++ = '.';
+			pattern++;
+		} else if(*pattern == '\\' && pattern[1] != '\0') {
+			pattern++;
+			if(strchr(regex_special, *pattern) != NULL ||
+					strchr("*?[]", *pattern) != NULL) {
+				*output++ = '\\';
+			}
+			*output++ = *pattern++;
+		} else if(*pattern == '[') {
+			const char *end = bracket_end(pattern + 1);
+			if(end == NULL) {
+				*output++ = '\\';
+				*output++ = *pattern++;
+				continue;
+			}
+			*output++ = *pattern++;
+			if(*pattern == '!' || *pattern == '^') {
+				*output++ = '^';
+				pattern++;
+			}
+			while(pattern <= end) {
+				*output++ = *pattern++;
+			}
+		} else {
+			if(strchr(regex_special, *pattern) != NULL) {
+				*output++ = '\\';
+			}
+			*output++ = *pattern++;
+		}
+	}
+	*output++ = '$';
+	*output = '\0';
+
+	result = regcomp(&regex, expression, REG_EXTENDED | REG_NOSUB);
+	free(expression);
+	if(result != 0) {
+		return FNM_NOMATCH;
+	}
+	result = regexec(&regex, string, 0, NULL, 0);
+	regfree(&regex);
+	return result == 0 ? 0 : FNM_NOMATCH;
+}
