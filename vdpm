#!/usr/bin/env bash

# The vdpm in a checkout, and the one CI scripts download from master, is not
# the client: the client is the one the SDK installed. This used to be a second
# implementation of it, which looked for pacman where no SDK puts it and failed
# for everybody who ran it -- including ./install-all.sh straight after a
# bootstrap. Handing over keeps one implementation, and on an SDK that predates
# the package client it hands over to the vdpm that SDK shipped.

set -euo pipefail

die() {
	printf 'vdpm: %s\n' "$*" >&2
	exit 1
}

[[ -n ${VITASDK:-} && $VITASDK == /* && $VITASDK != / ]] ||
	die 'VITASDK must be an absolute, non-root path, such as: export VITASDK=/usr/local/vitasdk'
VITASDK=${VITASDK%/}

client=$VITASDK/bin/vdpm
self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")

[[ -x $client ]] || die "no VitaSDK at $VITASDK; install one with
  curl -fsSL https://github.com/vitasdk/vdpm/releases/latest/download/bootstrap-vitasdk.sh | bash
or ./bootstrap-vitasdk.sh from a vdpm checkout"
[[ ! $client -ef $self ]] ||
	die "$client is this script, not a package client; reinstall with ./bootstrap-vitasdk.sh"

exec "$client" "$@"
